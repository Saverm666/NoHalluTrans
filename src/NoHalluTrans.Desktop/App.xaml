<Application x:Class="NoHalluTrans.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:NoHalluTrans.Desktop">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" /></ResourceDictionary.MergedDictionaries>
      <Style TargetType="local:AnchoredComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}"/>
      <local:VisibilityConverter x:Key="VisibleWhen"/>
      <local:LabelConverter x:Key="OptionLabel"/>
      <Style x:Key="PageHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="28"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
      <Style x:Key="PageCaption" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,0,0,28"/></Style>
      <Style x:Key="SectionHeading" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
      <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/><Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="24"/></Style>
      <Style x:Key="FormField" TargetType="TextBox"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
      <Style x:Key="SecondaryText" TargetType="TextBlock"><Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
      <DataTemplate x:Key="OptionTemplate"><TextBlock Text="{Binding Converter={StaticResource OptionLabel}}"/></DataTemplate>
    </ResourceDictionary>
  </Application.Resources>
</Application>
