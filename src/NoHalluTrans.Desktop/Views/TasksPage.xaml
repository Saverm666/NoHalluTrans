<UserControl xmlns:local="using:NoHalluTrans.Desktop" x:Class="NoHalluTrans.Desktop.Views.TasksPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32,28,32,24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,20" ColumnSpacing="24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="论文翻译" Style="{StaticResource PageHeading}" VerticalAlignment="Center" Margin="0"/>
      <!-- Prerequisite hint sits beside the heading so it never pushes the form down. -->
      <InfoBar Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="560" Severity="Warning" IsClosable="False" IsOpen="{Binding HasSetupHint, Mode=OneWay}" Message="{Binding SetupHint}" AutomationProperties.AutomationId="SetupHint">
        <InfoBar.ActionButton><Button Content="前往设置" Click="SetupHint_Click"/></InfoBar.ActionButton>
      </InfoBar>
    </Grid>
    <Grid Grid.Row="1" ColumnSpacing="24">
      <Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Padding="0,4,24,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,1,0">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="新建翻译" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Click="Advanced_Click" Padding="10,4" VerticalAlignment="Center" ToolTipService.ToolTip="配置原文语言、编译引擎、主文件提示等高级参数；数字表示已修改的项目数" AutomationProperties.AutomationId="AdvancedOptionsButton">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE713;" FontSize="13"/><TextBlock Text="{Binding AdvancedSummary}" FontSize="12"/></StackPanel>
              </Button>
            </Grid>
            <StackPanel Spacing="6">
              <TextBox x:Name="SourceBox" Header="论文来源" PlaceholderText="输入 arXiv 编号，例如 1706.03762" Text="{Binding Source, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="False" MinHeight="48" MaxHeight="80" KeyDown="Source_KeyDown" AutomationProperties.AutomationId="SourceInput" ToolTipService.ToolTip="支持 arXiv 编号、链接或拖入 TeX 源码压缩包。按 Enter 开始翻译。"/>
              <Grid ColumnSpacing="6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE7BA;" FontSize="12" Margin="0,2,0,0" VerticalAlignment="Top" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{Binding SourceHintIsWarning, Converter={StaticResource VisibleWhen}}"/>
                <TextBlock Grid.Column="1" Text="{Binding SourceHint}" FontSize="12" Style="{StaticResource SecondaryText}" AutomationProperties.AutomationId="SourceHint"/>
              </Grid>
              <Grid ColumnSpacing="8" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="导入源码包" Command="{Binding BrowseSourceCommand}" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="源码文件夹" Command="{Binding BrowseFolderCommand}" HorizontalAlignment="Stretch"/></Grid>
            </StackPanel>
            <local:AnchoredComboBox Header="翻译为" ItemsSource="{Binding Languages}" ItemTemplate="{StaticResource OptionTemplate}" SelectedItem="{Binding TargetLanguage, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Header="输出目录" Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTipService.ToolTip="仅保存最终 PDF；源码、日志及中间文件留在任务工作目录。" AutomationProperties.AutomationId="OutputDirectoryInput"/><Button Grid.Column="1" Content="选择" Command="{Binding BrowseOutputCommand}" VerticalAlignment="Bottom"/></Grid>
            <local:AnchoredComboBox Header="PDF 格式" ItemsSource="{Binding PdfLayouts}" ItemTemplate="{StaticResource OptionTemplate}" SelectedItem="{Binding PdfLayout, Mode=TwoWay}" HorizontalAlignment="Stretch" AutomationProperties.AutomationId="PdfLayoutInput"/>
            <Button Command="{Binding AddTaskCommand}" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Margin="0,4,0,0" Padding="16,9" AutomationProperties.AutomationId="AddTaskButton"><StackPanel Orientation="Horizontal" Spacing="10"><FontIcon Glyph="&#xE768;" FontSize="14"/><TextBlock Text="{Binding AddTaskLabel}"/></StackPanel></Button>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Grid Grid.Column="1" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*" MinHeight="200"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid ColumnSpacing="8">
          <!-- The search column takes the free space up to 220px; the small spacer absorbs the rest, keeping it right-aligned. -->
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="0.1*" MinWidth="8"/><ColumnDefinition Width="*" MaxWidth="220"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center"><TextBlock Text="任务记录" Style="{StaticResource SectionHeading}" VerticalAlignment="Center"/><Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="{Binding TaskCount}" FontSize="12"/></Border></StackPanel>
          <TextBox Grid.Column="2" MinWidth="0" HorizontalAlignment="Stretch" PlaceholderText="搜索标题或来源" Text="{Binding TaskSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="搜索任务" AutomationProperties.AutomationId="TaskSearch"/>
          <Button Grid.Column="3" Style="{StaticResource ToolbarButton}" VerticalAlignment="Center" ToolTipService.ToolTip="对多个任务执行操作" AutomationProperties.Name="批量操作">
            <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE762;" FontSize="14"/><TextBlock Text="批量"/></StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuFlyoutItem Text="取消全部排队任务" Command="{Binding CancelQueuedCommand}"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE711;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
                <MenuFlyoutItem Text="清除已结束任务…" Click="ClearFinished_Click" IsEnabled="{Binding HasFinishedTasks}"><MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;"/></MenuFlyoutItem.Icon></MenuFlyoutItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>
        </Grid>
        <SelectorBar Grid.Row="1" x:Name="FilterBar" SelectionChanged="Filter_Changed" AutomationProperties.AutomationId="TaskFilter">
          <SelectorBarItem Text="全部" Tag="all" IsSelected="True"/>
          <SelectorBarItem Text="进行中" Tag="active"/>
          <SelectorBarItem Text="已完成" Tag="done"/>
          <SelectorBarItem Text="失败 / 中断" Tag="failed"/>
        </SelectorBar>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
          <Grid>
            <ListView x:Name="TaskList" ItemsSource="{Binding FilteredTasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}" SelectionMode="Single" IsItemClickEnabled="False" BorderThickness="0" Background="Transparent" Padding="4" HorizontalContentAlignment="Stretch" ContextRequested="TaskList_ContextRequested" DoubleTapped="TaskList_DoubleTapped" AutomationProperties.AutomationId="TaskList">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="8,10" ColumnSpacing="12" RowSpacing="4" HorizontalAlignment="Stretch" Background="Transparent">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.RowSpan="3" CornerRadius="8" Background="{ThemeResource AccentFillColorTertiaryBrush}" Width="36" Height="40" VerticalAlignment="Top"><FontIcon Glyph="&#xE8A5;" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" FontSize="18"/></Border>
                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Options.Source}"/>
                    <Grid Grid.Column="2" Grid.RowSpan="3" VerticalAlignment="Center">
                      <Border Style="{StaticResource StatusPill}" Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}" Visibility="{Binding StatusKind, Converter={StaticResource VisibleWhen}, ConverterParameter='is:running,queued'}"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}" Foreground="{ThemeResource SystemFillColorAttentionBrush}"/></Border>
                      <Border Style="{StaticResource StatusPill}" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" Visibility="{Binding StatusKind, Converter={StaticResource VisibleWhen}, ConverterParameter='is:done'}"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/></Border>
                      <Border Style="{StaticResource StatusPill}" Background="{ThemeResource SystemFillColorCautionBackgroundBrush}" Visibility="{Binding StatusKind, Converter={StaticResource VisibleWhen}, ConverterParameter='is:warning'}"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}" Foreground="{ThemeResource SystemFillColorCautionBrush}"/></Border>
                      <Border Style="{StaticResource StatusPill}" Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" Visibility="{Binding StatusKind, Converter={StaticResource VisibleWhen}, ConverterParameter='is:failed'}"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}" Foreground="{ThemeResource SystemFillColorCriticalBrush}"/></Border>
                      <Border Style="{StaticResource StatusPill}" Background="{ThemeResource SystemFillColorNeutralBackgroundBrush}" Visibility="{Binding StatusKind, Converter={StaticResource VisibleWhen}, ConverterParameter='is:idle'}"><TextBlock Text="{Binding Status}" Style="{StaticResource StatusPillText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></Border>
                    </Grid>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding MetaLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SubLabel}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Detail}"/>
                    <ProgressBar Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Value="{Binding Percent}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="3" Margin="0,4,0,0" Visibility="{Binding IsActive, Converter={StaticResource VisibleWhen}}"/>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12" MaxWidth="300" Visibility="{Binding TaskCount, Converter={StaticResource VisibleWhen}, ConverterParameter=inverse}" IsHitTestVisible="False">
              <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="20" Width="56" Height="56" HorizontalAlignment="Center"><FontIcon Glyph="&#xE8A5;" FontSize="26" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/></Border>
              <TextBlock Text="暂无任务" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,6,0,0"/>
              <TextBlock Text="在左侧填写论文来源，或把源码包拖入窗口。" Style="{StaticResource SecondaryText}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" IsHitTestVisible="False" Visibility="{Binding FilteredEmpty, Converter={StaticResource VisibleWhen}}">
              <FontIcon Glyph="&#xE721;" FontSize="26" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <TextBlock Text="没有符合条件的任务" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
          </Grid>
        </Border>
        <Border Grid.Row="3" Padding="0,16,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Visibility="{Binding HasSelectedTask, Converter={StaticResource VisibleWhen}}">
          <StackPanel Spacing="10">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding SelectedTask.Title}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SelectedTask.OutputLabel}"/>
              <TextBlock Text="{Binding SelectedTask.BlockSummaryInline}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding SelectedTask.BlockSummary}" AutomationProperties.AutomationId="SelectedTaskProgress"/>
            </StackPanel>
            <Grid ColumnSpacing="8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="打开译文" Style="{StaticResource ToolbarAccentButton}" Command="{Binding OpenPdfCommand}" Visibility="{Binding SelectedTask.HasOutput, Converter={StaticResource VisibleWhen}}" ToolTipService.ToolTip="也可双击任务或按 Enter 打开"/>
              <Button Content="重新运行" Style="{StaticResource ToolbarButton}" Command="{Binding RetryCommand}" Visibility="{Binding SelectedTask.IsActive, Converter={StaticResource VisibleWhen}, ConverterParameter=inverse}"/>
              <Button Content="取消任务" Style="{StaticResource ToolbarButton}" Command="{Binding CancelCommand}" Visibility="{Binding SelectedTask.IsActive, Converter={StaticResource VisibleWhen}}"/>
              <Button Style="{StaticResource IconButton}" Click="DeleteTask_Click" IsEnabled="{Binding CanDeleteSelectedTask}" Visibility="{Binding SelectedTask.IsActive, Converter={StaticResource VisibleWhen}, ConverterParameter=inverse}" Foreground="{ThemeResource SystemFillColorCriticalBrush}" ToolTipService.ToolTip="删除任务记录及其工作目录（Delete）" AutomationProperties.Name="删除任务" AutomationProperties.AutomationId="DeleteTaskButton"><FontIcon Glyph="&#xE74D;" FontSize="14"/></Button>
              <Button Style="{StaticResource IconButton}" ToolTipService.ToolTip="更多操作" AutomationProperties.Name="更多操作"><FontIcon Glyph="&#xE712;" FontSize="14"/>
                <Button.Flyout>
                  <MenuFlyout>
                    <MenuFlyoutItem Text="在文件夹中显示译文" Command="{Binding RevealPdfCommand}"/>
                    <MenuFlyoutItem Text="复制输出路径" Command="{Binding CopyOutputPathCommand}"/>
                    <MenuFlyoutItem Text="打开原文 PDF" Command="{Binding OpenOriginalCommand}"/>
                    <MenuFlyoutSeparator/>
                    <MenuFlyoutItem Text="导出译后源码" Command="{Binding ExportSourceCommand}"/>
                    <MenuFlyoutItem Text="导出诊断日志" Command="{Binding ExportLogsCommand}"/>
                    <MenuFlyoutItem Text="打开工作目录" Command="{Binding OpenWorkCommand}"/>
                  </MenuFlyout>
                </Button.Flyout>
              </Button>
            </StackPanel>
              <ToggleButton Grid.Column="1" Height="32" Padding="12,0" VerticalContentAlignment="Center" IsChecked="{Binding IsLogExpanded, Mode=TwoWay}" ToolTipService.ToolTip="显示运行日志，运行中自动刷新" AutomationProperties.AutomationId="TaskLogToggle">
                <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE9D9;" FontSize="13"/><TextBlock Text="日志"/></StackPanel>
              </ToggleButton>
            </Grid>
            <local:AnchoredComboBox Header="选择主文件后重新运行" ItemsSource="{Binding MainCandidates}" SelectedItem="{Binding SelectedMainCandidate, Mode=TwoWay}" HorizontalAlignment="Stretch" Visibility="{Binding MainCandidates.Length, Converter={StaticResource VisibleWhen}}"/>
            <TextBox Text="{Binding TaskLog, Mode=OneWay}" Visibility="{Binding IsLogExpanded, Converter={StaticResource VisibleWhen}}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas, Microsoft YaHei UI" MaxHeight="180" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="运行日志"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
