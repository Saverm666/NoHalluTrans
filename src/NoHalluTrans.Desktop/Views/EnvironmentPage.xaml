<UserControl x:Class="NoHalluTrans.Desktop.Views.EnvironmentPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32,28,32,24" RowSpacing="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="编译环境" Style="{StaticResource PageHeading}"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="16">
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Grid Padding="20,16" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE756;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="TeX Live 2026" FontWeight="SemiBold" FontSize="16"/>
                <TextBlock Text="{Binding EnvironmentSummary}" Style="{StaticResource SecondaryText}" FontSize="12"/>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="检查环境" Command="{Binding CheckEnvironmentCommand}"/>
                <Button Content="{Binding EnvironmentSetupLabel}" Command="{Binding SetupEnvironmentCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="SetupEnvironmentButton"/>
                <Button Content="取消" Command="{Binding CancelEnvironmentCommand}" Visibility="{Binding IsEnvironmentBusy, Converter={StaticResource VisibleWhen}}"/>
              </StackPanel>
            </Grid>
            <Grid Padding="20,14" ColumnSpacing="20" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <TextBlock Text="安装位置" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding RuntimeRoot, Mode=OneWay}" Style="{StaticResource SecondaryText}" IsTextSelectionEnabled="True" VerticalAlignment="Center" FontSize="13"/>
            </Grid>
            <StackPanel Padding="20,16" Spacing="10">
              <TextBlock Text="运行日志与诊断" FontWeight="SemiBold" FontSize="13"/>
              <StackPanel Spacing="6" Visibility="{Binding IsEnvironmentBusy, Converter={StaticResource VisibleWhen}}">
                <TextBlock Text="{Binding EnvironmentStage}" FontSize="12" Style="{StaticResource SecondaryText}"/>
                <ProgressBar Value="{Binding EnvironmentPercent}" IsIndeterminate="{Binding IsEnvironmentIndeterminate}"/>
              </StackPanel>
              <TextBox Text="{Binding EnvironmentReport, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" FontSize="12" Padding="14,12" MinHeight="120" MaxHeight="240" FontFamily="Consolas, Microsoft YaHei UI"/>
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Grid Padding="20,16" ColumnSpacing="20">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="任务工作目录" FontWeight="SemiBold"/>
                <TextBlock Text="保存源码、日志与编译中间文件，需为纯英文路径。" Style="{StaticResource SecondaryText}" FontSize="12"/>
              </StackPanel>
              <Grid Grid.Column="1" ColumnSpacing="8" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox MinWidth="0" Text="{Binding Settings.WorkRoot, Mode=TwoWay}" AutomationProperties.Name="任务工作目录" ToolTipService.ToolTip="保存源码、日志及编译中间文件，需为可写的纯英文路径。最终 PDF 保存到主页的输出目录。"/>
                <Button Grid.Column="1" Content="选择目录" Command="{Binding BrowseWorkCommand}"/>
              </Grid>
            </Grid>
            <Grid Padding="20,16" ColumnSpacing="20" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3">
                <TextBlock Text="自动补充缺失宏包" FontWeight="SemiBold"/>
                <TextBlock Text="编译时联网补齐缺失宏包，下载文件保存在便携目录。" Style="{StaticResource SecondaryText}" FontSize="12"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" IsOn="{Binding Settings.AutoInstallPackages, Mode=TwoWay}" OnContent="开启" OffContent="关闭" MinWidth="0" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="允许联网安装缺失宏包"/>
            </Grid>
          </StackPanel>
        </Border>
        <Grid Margin="0,2,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
            <Button Content="打开模板库" Command="{Binding OpenTemplateLibraryCommand}" ToolTipService.ToolTip="将官方模板解压到模板库，任务缺少文件时可离线复用。"/>
            <Button Content="保存设置" Style="{StaticResource AccentButtonStyle}" Command="{Binding SaveSettingsCommand}" Padding="20,9"/>
          </StackPanel>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
