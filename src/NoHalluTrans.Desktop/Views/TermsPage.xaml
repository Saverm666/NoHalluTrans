<UserControl x:Class="NoHalluTrans.Desktop.Views.TermsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32,28,32,24" RowSpacing="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="术语表" Style="{StaticResource PageHeading}" Margin="0"/><Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="10" Padding="8,2" VerticalAlignment="Center"><TextBlock Text="{Binding Terms.Count}" FontSize="12"/></Border></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBox Width="200" PlaceholderText="搜索原文或译法" Text="{Binding TermSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索术语" AutomationProperties.AutomationId="TermSearch"/>
        <Button Content="导入 JSON" Command="{Binding ImportTermsCommand}"/>
        <Button Content="导出 JSON" Command="{Binding ExportTermsCommand}"/>
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
      <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid Padding="24,18" ColumnSpacing="16" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="8,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBlock Text="原文术语" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="固定译法" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="区分大小写" FontSize="12" HorizontalAlignment="Center"/></Grid>
        <ListView x:Name="TermList" Grid.Row="1" ItemsSource="{Binding FilteredTerms}" SelectedItem="{Binding SelectedTerm, Mode=TwoWay}" HorizontalContentAlignment="Stretch" SelectionMode="Single" Padding="8" ToolTipService.ToolTip="选择术语可修改译法；按 Delete 删除。">
          <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
          <ListView.ItemTemplate><DataTemplate><Grid Padding="16,14" ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Target}" TextTrimming="CharacterEllipsis"/><CheckBox Grid.Column="2" IsChecked="{Binding CaseSensitive, Mode=OneWay}" IsEnabled="False" HorizontalAlignment="Center" MinWidth="0" MinHeight="0"/></Grid></DataTemplate></ListView.ItemTemplate>
        </ListView>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" IsHitTestVisible="False" Visibility="{Binding Terms.Count, Converter={StaticResource VisibleWhen}, ConverterParameter=inverse}"><FontIcon Glyph="&#xE82D;" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/><TextBlock Text="暂无术语" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center"/></StackPanel>
        <TextBlock Grid.Row="1" Text="没有匹配的术语" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" IsHitTestVisible="False" Visibility="{Binding NoTermMatches, Converter={StaticResource VisibleWhen}}"/>
      </Grid>
    </Border>
    <Border Grid.Row="2" Padding="0,20,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
      <StackPanel Spacing="16">
        <Grid ColumnSpacing="16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions>
          <TextBox x:Name="TermSourceBox" Header="原文" PlaceholderText="例如 attention mechanism" Text="{Binding TermSource, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="TermField_KeyDown"/>
          <TextBox x:Name="TermTargetBox" Grid.Column="1" Header="译文" PlaceholderText="例如 注意力机制" Text="{Binding TermTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" KeyDown="TermField_KeyDown" ToolTipService.ToolTip="按 Enter 保存"/>
          <ToggleSwitch x:Name="TermCaseBox" Grid.Column="2" Header="区分大小写" IsOn="{Binding TermCaseSensitive, Mode=TwoWay}" OnContent="是" OffContent="否"/>
        </Grid>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="{Binding TermActionLabel}" Style="{StaticResource AccentButtonStyle}" Command="{Binding AddTermCommand}" AutomationProperties.AutomationId="SaveTermButton"/>
            <Button Content="新建" Command="{Binding NewTermCommand}" ToolTipService.ToolTip="取消选择并清空编辑框"/>
            <Button Content="删除所选" Click="DeleteTerm_Click" IsEnabled="{Binding HasSelectedTerm}"/>
          </StackPanel>
          <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Style="{StaticResource SecondaryText}" Text="原文相同的术语会被更新，不会重复添加。"/>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</UserControl>
