<UserControl xmlns:local="using:NoHalluTrans.Desktop" x:Class="NoHalluTrans.Desktop.Views.ModelPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid Padding="32,28,32,24" RowSpacing="20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Spacing="4">
      <TextBlock Text="模型连接" Style="{StaticResource PageHeading}"/>
      
    </StackPanel>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
      <StackPanel Spacing="16">
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Grid Padding="20,16" ColumnSpacing="12" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border Width="36" Height="36" CornerRadius="8" Background="{ThemeResource AccentFillColorDefaultBrush}" VerticalAlignment="Center"><FontIcon Glyph="&#xE774;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"/></Border>
              <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="服务连接" FontWeight="SemiBold" FontSize="16"/></StackPanel>
              <Border Grid.Column="2" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="9,4" VerticalAlignment="Center"><TextBlock Text="OpenAI 兼容" FontSize="11" Style="{StaticResource SecondaryText}"/></Border>
            </Grid>
            <Grid Padding="20,16" ColumnSpacing="20" RowSpacing="14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="接口地址" VerticalAlignment="Center"/>
              <TextBox x:Name="BaseUrlBox" IsEnabled="{Binding CanEditModelConnection}" Grid.Column="1" PlaceholderText="https://api.example.com/v1" MinWidth="0" Text="{Binding Settings.Model.BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" TextChanged="ConnectionField_Changed" AutomationProperties.Name="接口地址" AutomationProperties.AutomationId="ModelBaseUrl" ToolTipService.ToolTip="填写服务商给出的 API 基础地址，通常以 /v1 结尾。"/>
              <TextBlock Grid.Row="1" Text="API 密钥" VerticalAlignment="Center"/>
              <PasswordBox IsEnabled="{Binding CanEditModelConnection}" Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" MinWidth="0" PlaceholderText="输入 API 密钥" PasswordRevealMode="Peek" PasswordChanged="ApiKey_Changed" AutomationProperties.Name="API 密钥" ToolTipService.ToolTip="密钥加密保存在便携目录，仅当前 Windows 用户可解密。"/>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Padding="0">
          <StackPanel>
            <Grid Padding="20,16" ColumnSpacing="20">
              <Grid.ColumnDefinitions><ColumnDefinition Width="108"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" Spacing="3"><TextBlock Text="翻译模型" FontWeight="SemiBold"/></StackPanel>
              <StackPanel Grid.Column="1" Spacing="7">
                <Grid ColumnSpacing="10"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <local:AnchoredComboBox x:Name="ModelSelector" ItemsSource="{Binding AvailableModels}" IsEditable="True" IsTextSearchEnabled="True" IsEnabled="{Binding CanEditModelConnection}" PlaceholderText="选择或输入模型 ID" ToolTipService.ToolTip="可获取模型列表后选择，也可手动输入完整模型 ID。" Text="{Binding ModelId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" MinWidth="0" MaxDropDownHeight="280" AutomationProperties.Name="翻译模型 ID" AutomationProperties.AutomationId="ModelSelector"/>
                  <Button Grid.Column="1" Click="FetchModels_Click" IsEnabled="{Binding CanEditModelConnection}" AutomationProperties.AutomationId="FetchModelsButton"><StackPanel Orientation="Horizontal" Spacing="7"><ProgressRing Width="14" Height="14" IsActive="{Binding IsFetchingModels}" Visibility="{Binding IsFetchingModels, Converter={StaticResource VisibleWhen}}"/><TextBlock Text="获取模型"/></StackPanel></Button>
                </Grid>
                
              </StackPanel>
            </Grid>
            <Grid Padding="20,12" ColumnSpacing="16" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <FontIcon Glyph="&#xE713;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="高级参数" FontSize="13"/></StackPanel>
              <Button Grid.Column="2" Content="调整" ToolTipService.ToolTip="批量、并发、超时与思考模式" IsEnabled="{Binding CanEditModelConnection}" Click="Advanced_Click" AutomationProperties.AutomationId="ModelAdvancedButton" VerticalAlignment="Center"/>
            </Grid>
          </StackPanel>
        </Border>
        <Grid ColumnSpacing="12" Margin="0,2,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          
          <Button Grid.Column="1" Click="TestConnection_Click" IsEnabled="{Binding CanEditModelConnection}" Padding="16,9"><StackPanel Orientation="Horizontal" Spacing="8"><ProgressRing Width="16" Height="16" IsActive="{Binding IsTestingModelConnection}" Visibility="{Binding IsTestingModelConnection, Converter={StaticResource VisibleWhen}}"/><TextBlock Text="测试连接"/></StackPanel></Button>
          <Button Grid.Column="2" Content="保存设置" Style="{StaticResource AccentButtonStyle}" Click="SaveSettings_Click" IsEnabled="{Binding CanEditModelConnection}" Padding="20,9"/>
        </Grid>

      </StackPanel>
    </ScrollViewer>
    <InfoBar Grid.RowSpan="2" Canvas.ZIndex="40" MaxWidth="480" HorizontalAlignment="Right" VerticalAlignment="Top" IsOpen="{Binding IsModelConnectionResultVisible, Mode=OneWay}" Severity="{Binding ModelConnectionSeverity}" Title="{Binding ModelConnectionTitle}" Message="{Binding ModelConnectionMessage}" IsClosable="True" Closed="ConnectionResult_Closed"/>
  </Grid>
</UserControl>
