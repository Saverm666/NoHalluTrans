<UserControl xmlns:local="using:NoHalluTrans.Desktop" x:Class="NoHalluTrans.Desktop.Views.ModelParameters" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid RowSpacing="20" ColumnSpacing="20" MinWidth="400">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <NumberBox Header="每批片段数" Value="{Binding Settings.Model.BatchSize, Mode=TwoWay}" Minimum="1" Maximum="64" SpinButtonPlacementMode="Inline" SmallChange="1"/>
    <NumberBox Grid.Column="1" Header="并发请求" Value="{Binding Settings.Model.Concurrency, Mode=TwoWay}" Minimum="1" Maximum="16" SpinButtonPlacementMode="Inline" SmallChange="1"/>
    <NumberBox Grid.Row="1" Header="超时（秒）" Value="{Binding Settings.Model.TimeoutSeconds, Mode=TwoWay}" Minimum="5" Maximum="3600" SpinButtonPlacementMode="Inline"/>
    <NumberBox Grid.Row="1" Grid.Column="1" Header="重试轮数" Value="{Binding Settings.Model.MaxRounds, Mode=TwoWay}" Minimum="1" Maximum="10" SpinButtonPlacementMode="Inline"/>
    <NumberBox Grid.Row="2" Header="最大输出 token" Value="{Binding Settings.Model.MaxOutputTokens, Mode=TwoWay}" Minimum="256" Maximum="131072" SpinButtonPlacementMode="Inline"/>
    <local:AnchoredComboBox Grid.Row="2" Grid.Column="1" Header="推理模式" ItemsSource="{Binding ThinkingModes}" ItemTemplate="{StaticResource OptionTemplate}" SelectedItem="{Binding Settings.Model.Thinking, Mode=TwoWay}" HorizontalAlignment="Stretch"/>
  </Grid>
</UserControl>
